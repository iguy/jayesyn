---
// jayesyn.com — single page: Music, Save Us Tonight (SGL 003)
// Drop this into src/pages/music-save-us-tonight.astro
//
// TODOs before launch, all marked below:
//   1. Paste full lyrics into the LYRICS array (same section/lines structure as One Human Rhythm).
//   2. Confirm/replace the "song story" paragraph — it's drafted from the DescribeMusic
//      analysis, in your voice, but you know the real story better than any tool does.
//
// NOTE: the audio player was intentionally removed — the song isn't out yet, so there's
// nothing to stream.

const song = {
  code: 'SGL 003',
  title: 'Music, Save Us Tonight',
  releaseDate: 'October 6, 2026',
  // Pre-launch: this hyperfollow link collects pre-saves. After release day,
  // swap this to the song's permanent streaming link and change ctaLabel below
  // from 'Pre-save on all platforms' to 'Stream now' (both CTA buttons on this
  // page pull from these two values, so this is the only place to edit).
  hyperfollow: 'https://distrokid.com/hyperfollow/jayesyn/music-save-us-tonight',
  ctaLabel: 'Pre-save on all platforms',
  art: '/art/jayesyn-music-save-us.jpeg',
  genre: 'House / Pop House',
  bpm: 124,
  key: 'C minor',
  tags: ['house', 'pop-house', 'uplifting', 'anthemic', 'gospel-influenced', 'energetic', 'four-on-the-floor', 'male vocals'],
};

// Straight from the track's own audio analysis — used below to draw the mood chart.
const moods = [
  { label: 'Energetic', value: 90 },
  { label: 'Excited', value: 80 },
  { label: 'Happy', value: 60 },
  { label: 'Calm', value: 10 },
  { label: 'Peaceful', value: 0 },
  { label: 'Relaxed', value: 0 },
  { label: 'Sad', value: 0 },
  { label: 'Tense', value: 10 },
  { label: 'Melancholic', value: 0 },
  { label: 'Angry', value: 0 },
];

// Precomputed 10-axis radar polygon (200x200 viewBox, center 100,100).
// r = 8 + (value/100)*80, angles at 36° steps starting from top, clockwise.
const radarPoints = '100,20 142.3,41.8 153.3,82.7 115.2,104.9 104.7,106.5 100,108 95.3,106.5 84.8,104.9 92.4,97.5 95.3,93.5';

const LYRICS = [
  {
    section: 'Pre-Chorus',
    lines: ['Save us... save us...'],
  },
  {
    section: 'Verse',
    lines: [
      'Turn it up, tune it out',
      'Let the noise all fade behind',
      'Whatever they tried to sell us today',
      "We're leaving it all outside tonight",
    ],
  },
  {
    section: 'Pre-Chorus',
    lines: [
      'Cause one sound never left us',
      'One sound always knew',
      'So turn it up now',
    ],
  },
  {
    section: 'Chorus',
    lines: [
      'Music, save us tonight',
      "You're the only truth left alive",
      'One language, no borders, no sides',
      'Music, save us tonight',
    ],
  },
  {
    section: 'Verse',
    lines: [
      "Doesn't matter where you're from",
      "Doesn't matter who you are",
      'One beat and the whole room moves',
      'Hands up, wherever you are',
    ],
  },
  {
    section: 'Pre-Chorus',
    lines: [
      'And it lives in me, it lives in you',
      'The one thing real, the one thing true',
      'So turn it up now',
    ],
  },
  {
    section: 'Chorus',
    lines: [
      'Music, save us tonight',
      "You're the only truth left alive",
      'One language, no borders, no sides',
      'Music, save us tonight',
    ],
  },
  {
    section: 'Bridge',
    lines: [
      'Beyond every language',
      'Beyond every name',
      'Just a feeling, just a rhythm',
      'Pulling at us the same',
      "No one's a stranger",
      'Out here on the floor',
      'Hands in the air',
      "'Cause we've been here before",
    ],
  },
  {
    section: 'Final Chorus',
    lines: [
      'Music, save us tonight',
      '(save us, save us)',
      "You're the only truth left alive",
      '(the only truth)',
      'No borders, no sides',
      'Music, save us tonight',
      '(save us, save us)',
      "You're the only truth left alive",
      '(the only truth)',
      'No borders, no sides',
      'Music, save us tonight',
      'Save us... Save us',
      'Tonight',
    ],
  },
];

import Layout from './layout.astro';
---

<Layout
  title="Music, Save Us Tonight — Jayesyn"
  description="Music, Save Us Tonight — Jayesyn. A gospel-tinged house anthem about music as a unifying force, out October 6, 2026."
  canonical="https://jayesyn.com/music-save-us-tonight"
>

<header class="top">
  <a class="back" href="/">&larr; Jayesyn</a>
  <span class="top-name">Music, Save Us Tonight</span>
  <a class="top-link" href={song.hyperfollow} target="_blank" rel="noopener">Pre-save</a>
</header>

<main>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow">{song.code} &middot; {song.releaseDate}</p>
      <h1>Music,<br />Save Us<br />Tonight</h1>
      <p class="lede">
        A gospel-lit house anthem built for the floor at 1am, when the room
        needs one more reason to keep going &mdash; the hook doesn't ask,
        it <span class="hook">&ldquo;save us tonight.&rdquo;</span>
      </p>
      <div class="tag-row">
        {song.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
      <a class="cta" href={song.hyperfollow} target="_blank" rel="noopener">{song.ctaLabel}</a>
    </div>

    <div class="art-wrap drift-xy">
      <p class="cover-artist">Jayesyn</p>
      <div class="cover-band">
        <img class="cover-art" src={song.art} alt="" loading="lazy" />
      </div>
      <h2 class="cover-title">Music, Save<br />Us Tonight</h2>
    </div>
  </section>

  <!-- STORY + SOUND -->
  <section class="story" aria-labelledby="story-h">
    <div class="story-text">
      <h2 id="story-h" class="section-h">The story</h2>
      <p>
        This song leans into church before it leans into the club. The lead
        vocal is raspy and soulful, more testifying than singing, backed by a
        full choir that turns the hook into something closer to a chant than
        a chorus. At its core, it's classic four-on-the-floor house: punchy
        kick, crisp claps, a bassline that won't let go of the groove.
      </p>
      <p>
        The arrangement does real work getting there, though &mdash; filter
        sweeps and risers pull the tension tight before every drop, so each
        chorus lands like relief. Underneath the party, it's really a song
        about needing something bigger than yourself to get through the
        night, and finding it in the people around you.
      </p>
    </div>

    <div class="mood-card">
      <p class="mood-label">The sound, by the numbers</p>
      <svg class="mood-chart" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Mood profile: dominated by energetic, excited, and happy">
        <g class="mood-rings" fill="none" stroke="var(--line)" stroke-width="1">
          <circle cx="100" cy="100" r="28" />
          <circle cx="100" cy="100" r="56" />
          <circle cx="100" cy="100" r="84" />
        </g>
        <g class="mood-spokes" stroke="var(--line)" stroke-width="1">
          <line x1="100" y1="100" x2="100" y2="16" />
          <line x1="100" y1="100" x2="171.6" y2="53.4" />
          <line x1="100" y1="100" x2="180.6" y2="125.8" />
          <line x1="100" y1="100" x2="126.5" y2="182.1" />
          <line x1="100" y1="100" x2="61.1" y2="182.1" />
          <line x1="100" y1="100" x2="20" y2="140" />
          <line x1="100" y1="100" x2="20" y2="60" />
          <line x1="100" y1="100" x2="61.1" y2="17.9" />
          <line x1="100" y1="100" x2="18" y2="27.5" />
          <line x1="100" y1="100" x2="34.7" y2="86.5" />
        </g>
        <polygon points={radarPoints} class="mood-shape" />
        <text x="100" y="12" text-anchor="middle" class="mood-tag">ENERGETIC 90</text>
        <text x="178" y="38" text-anchor="start" class="mood-tag">EXCITED 80</text>
        <text x="180" y="87" text-anchor="start" class="mood-tag">HAPPY 60</text>
      </svg>
      <dl class="mood-stats">
        <div><dt>Genre</dt><dd>{song.genre}</dd></div>
        <div><dt>BPM</dt><dd>{song.bpm}</dd></div>
        <div><dt>Key</dt><dd>{song.key}</dd></div>
      </dl>
    </div>
  </section>

  <!-- LYRICS -->
  <section class="lyrics-section" aria-labelledby="lyrics-h">
    <h2 id="lyrics-h" class="section-h">Lyrics</h2>
    <p class="lyrics-credit">Words: Jason Nelson</p>
    <div class="lyrics">
      {LYRICS.map((block) => (
        <div class="lyrics-block">
          <p class="lyrics-label">{block.section}</p>
          {block.lines.map((line) => <p class="lyrics-line">{line}</p>)}
        </div>
      ))}
    </div>
  </section>

  <!-- BOTTOM CTA -->
  <section class="bottom-cta">
    <h2>Out {song.releaseDate}.</h2>
    <a class="cta" href={song.hyperfollow} target="_blank" rel="noopener">{song.ctaLabel} &mdash; Music, Save Us Tonight</a>
    <a class="secondary-link" href="/">Back to Jayesyn</a>
  </section>
</main>

<style is:global>
:root {
  --carbon: #121014;
  --carbon-deep: #0d0b10;
  --cream: #efe6d8;
  --uv: #6399bb;
  --uv-soft: #82b0cb;
  --line: #2a2333;
  --dim: #9b93a8;
  --amber: #e8a15c;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  background: var(--carbon);
  color: var(--cream);
  font-family: 'Space Grotesk', system-ui, sans-serif;
  font-size: 17px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}
a { color: var(--uv-soft); }
a:focus-visible, button:focus-visible { outline: 2px solid var(--uv-soft); outline-offset: 3px; }

/* header */
.top {
  display: flex; align-items: center; gap: 1rem;
  padding: 1.1rem clamp(1.25rem, 4vw, 3rem);
  border-bottom: 1px solid var(--line);
}
.back {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.8rem; text-decoration: none; color: var(--dim);
}
.back:hover { color: var(--cream); }
.top-name {
  font-family: 'Unbounded', sans-serif;
  font-weight: 700; font-size: 0.85rem; letter-spacing: 0.1em;
}
.top-link {
  margin-left: auto;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.8rem; text-decoration: none;
  color: var(--cream); border-bottom: 1px solid var(--uv);
  padding-bottom: 2px;
}
.top-link:hover { color: var(--uv-soft); }

/* hero */
.hero {
  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
  align-items: center;
  gap: clamp(2rem, 5vw, 4rem);
  padding: clamp(3rem, 8vw, 6rem) clamp(1.25rem, 4vw, 3rem);
  max-width: 1200px; margin: 0 auto;
}
.eyebrow {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--uv-soft); margin-bottom: 1rem;
}
h1 {
  font-family: 'Unbounded', sans-serif;
  font-weight: 900;
  font-size: clamp(2.2rem, 6.5vw, 4.4rem);
  line-height: 0.98; letter-spacing: -0.01em;
}
.lede { margin-top: 1.5rem; max-width: 32rem; font-size: 1.1rem; }
.hook { color: var(--uv-soft); font-style: italic; }
.tag-row { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.5rem; }
.tag {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.72rem; letter-spacing: 0.06em;
  color: var(--dim);
  border: 1px solid var(--line);
  border-radius: 999px;
  padding: 0.3rem 0.75rem;
}
.cta {
  display: inline-block; margin-top: 2rem;
  font-family: 'Unbounded', sans-serif;
  font-weight: 700; font-size: 0.85rem;
  text-decoration: none;
  background: var(--uv); color: var(--cream);
  padding: 0.9rem 1.6rem; border-radius: 999px;
  transition: background 160ms ease;
}
.cta:hover { background: var(--uv-soft); }

.art-wrap {
  position: relative; aspect-ratio: 1;
  background: var(--carbon-deep);
  border: 1px solid rgba(130, 176, 203, 0.25);
  display: flex; flex-direction: column; justify-content: center;
  border-radius: 6px; overflow: hidden;
  container-type: inline-size;
  box-shadow: 0 26px 64px -18px rgba(0, 0, 0, 0.9), 0 0 70px -20px rgba(99, 153, 187, 0.55);
}
.cover-artist {
  font-family: 'Unbounded', sans-serif;
  font-weight: 700;
  font-size: 7.5cqw;
  color: var(--cream);
  padding: 0 9%;
  margin-bottom: 5.5%;
}
.cover-title {
  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-weight: 700;
  font-size: 11cqw;
  line-height: 1.04;
  letter-spacing: -0.01em;
  text-transform: uppercase;
  color: var(--cream);
  padding: 0 9%;
  margin-top: 7%;
}
.cover-band {
  position: relative;
  width: 100%;
  height: 17.5%;
  overflow: hidden;
}
.cover-art {
  position: absolute;
  top: 0; left: 0;
  will-change: transform;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}
.drift-xy .cover-art {
  width: 145%;
  height: auto;
  animation-name: drift-xy;
  animation-duration: 48s;
}
@keyframes drift-xy {
  0%   { transform: translate(0%, -4%); }
  50%  { transform: translate(-31%, -76%); }
  100% { transform: translate(0%, -4%); }
}

/* player */
.player-section {
  max-width: 1200px; margin: 0 auto;
  padding: clamp(2rem, 5vw, 3rem) clamp(1.25rem, 4vw, 3rem);
  border-top: 1px solid var(--line);
}
.section-h {
  font-family: 'Unbounded', sans-serif; font-weight: 700;
  font-size: clamp(1.3rem, 2.6vw, 1.8rem); margin-bottom: 1.25rem;
}
/* story + mood chart */
.story {
  max-width: 1200px; margin: 0 auto;
  padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.25rem, 4vw, 3rem);
  border-top: 1px solid var(--line);
  display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(280px, 0.9fr);
  gap: clamp(2rem, 5vw, 4rem);
  align-items: start;
}
.story-text p { max-width: 34rem; margin-bottom: 1.1rem; color: var(--cream); }
.story-text p:last-child { margin-bottom: 0; }

.mood-card {
  background: var(--carbon-deep);
  border: 1px solid var(--line);
  border-radius: 6px;
  padding: 1.5rem;
}
.mood-label {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--dim); margin-bottom: 0.75rem;
}
.mood-chart { width: 100%; height: auto; }
.mood-shape {
  fill: rgba(232, 161, 92, 0.28);
  stroke: var(--amber);
  stroke-width: 1.5;
}
.mood-tag {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 6.5px; letter-spacing: 0.06em;
  fill: var(--dim);
}
.mood-stats {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 0.75rem; margin-top: 1.25rem;
  border-top: 1px solid var(--line); padding-top: 1.1rem;
}
.mood-stats dt {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--dim);
}
.mood-stats dd { font-weight: 500; margin-top: 0.2rem; font-size: 0.9rem; }

/* lyrics */
.lyrics-section {
  max-width: 1200px; margin: 0 auto;
  padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.25rem, 4vw, 3rem);
  border-top: 1px solid var(--line);
}
.lyrics-credit {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.78rem; color: var(--dim);
  margin-bottom: 1.75rem;
}
.lyrics {
  max-width: 60rem;
  columns: 3;
  column-gap: 2.5rem;
}
.lyrics-block {
  break-inside: avoid;
  margin-bottom: 1.75rem;
}
.lyrics-label {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--uv-soft);
  margin-bottom: 0.6rem;
}
.lyrics-line {
  font-size: 1rem; color: var(--cream);
  line-height: 1.5;
}

/* bottom cta */
.bottom-cta {
  max-width: 1200px; margin: 0 auto;
  padding: clamp(3rem, 8vw, 5.5rem) clamp(1.25rem, 4vw, 3rem);
  border-top: 1px solid var(--line);
  text-align: center;
}
.bottom-cta h2 {
  font-family: 'Unbounded', sans-serif; font-weight: 900;
  font-size: clamp(1.8rem, 5vw, 3rem);
}
.bottom-cta .cta { display: block; width: fit-content; margin: 2rem auto 0; }
.secondary-link {
  display: block; margin-top: 1.25rem;
  font-family: 'IBM Plex Mono', monospace; font-size: 0.85rem;
  color: var(--dim); text-decoration: none;
}
.secondary-link:hover { color: var(--cream); }

/* footer */
.foot { border-top: 1px solid var(--line); padding: 2.5rem clamp(1.25rem, 4vw, 3rem) 3rem; text-align: center; }
.foot-name { font-family: 'Unbounded', sans-serif; font-weight: 700; font-size: 0.9rem; letter-spacing: 0.2em; }
.foot-meta { margin-top: 0.75rem; font-size: 0.9rem; color: var(--dim); }
.foot-credit { margin-top: 0.5rem; font-family: 'IBM Plex Mono', monospace; font-size: 0.75rem; color: var(--dim); }

/* responsive */
@media (max-width: 820px) {
  .hero { grid-template-columns: 1fr; }
  .art-wrap { order: -1; }
  .story { grid-template-columns: 1fr; }
  .lyrics { columns: 1; }
}
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .drift-xy .cover-art { animation-duration: 100s; }
}
</style>

</Layout>