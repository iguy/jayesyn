---
// jayesyn.com — EP page: Jayesyn (self-titled, EP 001)
// Drop this into src/pages/jayesyn-ep.astro
//
// TODOs before launch:
//   1. Confirm release date and swap into `ep.releaseDate` below.
//   2. Add the EP's hyperfollow/pre-save link once one exists — currently
//      showing a "coming soon" note instead of a dead link.
//   3. Track 4 (bonus track) needs a title, story, and lyrics — once those
//      exist this page can grow a "the story" + lyrics section just like
//      the single pages, and track 4 can link to its own page if it gets one.

const ep = {
  code: 'EP 001',
  title: 'Jayesyn',
  subtitle: 'The EP',
  releaseDate: 'TBA 2026',
};

const tracks = [
  { n: 1, title: 'Common Ground', page: '/common-ground' },
  { n: 2, title: 'One Human Rhythm', page: '/one-human-rhythm' },
  { n: 3, title: 'Music, Save Us Tonight', page: '/music-save-us-tonight' },
  { n: 4, title: 'Bonus track — TBA', page: null },
];

// Composite cover: three live artwork bands stacked in one tile, each
// reusing the same drift technique (and drift direction) as its single's
// own cover, top to bottom: Music Save Us Tonight (violet) → One Human
// Rhythm (red) → Common Ground (teal).
const bands = [
  { art: '/art/jayesyn-music-save-us.jpeg', drift: 'drift-xy' },
  { art: '/art/jayesyn-One_Human_rhythm.jpeg', drift: 'drift-x' },
  { art: '/art/jayesyn-common-ground.jpeg', drift: 'drift-y' },
];

import Layout from './layout.astro';
---

<Layout
  title="Jayesyn — The EP"
  description="Jayesyn, the self-titled EP — three singles plus one new song, TBA 2026."
  canonical="https://jayesyn.com/jayesyn-ep"
>

<header class="top">
  <a class="back" href="/">&larr; Jayesyn</a>
  <span class="top-name">{ep.title} — {ep.subtitle}</span>
  <span class="top-link muted">Pre-save link coming soon</span>
</header>

<main>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow">{ep.code} &middot; {ep.releaseDate}</p>
      <h1>Jayesyn</h1>
      <p class="lede">
        Three singles, one self-titled EP. The public voice of
        &ldquo;Common Ground,&rdquo; &ldquo;One Human Rhythm,&rdquo; and
        &ldquo;Music, Save Us Tonight&rdquo; together, plus one more song
        that's just for the people who already know him.
      </p>
      <p class="cta-note">Pre-save link coming soon</p>
    </div>

    <div class="ep-cover">
      <p class="cover-artist">Jayesyn</p>
      {bands.map((band) => (
        <div class={`ep-band ${band.drift}`}>
          <img class="ep-band-art" src={band.art} alt="" loading="lazy" />
        </div>
      ))}
    </div>
  </section>

  <!-- TRACKLIST -->
  <section class="tracklist-section" aria-labelledby="tracklist-h">
    <h2 id="tracklist-h" class="section-h">Tracklist</h2>
    <ol class="tracklist">
      {tracks.map((track) => (
        <li class="track-row">
          <span class="track-n">{String(track.n).padStart(2, '0')}</span>
          {track.page ? (
            <a class="track-title" href={track.page}>{track.title}</a>
          ) : (
            <span class="track-title track-tba">{track.title}</span>
          )}
        </li>
      ))}
    </ol>
  </section>

  <!-- BOTTOM CTA -->
  <section class="bottom-cta">
    <h2>{ep.releaseDate}.</h2>
    <p class="cta-note">Pre-save link coming soon</p>
    <a class="secondary-link" href="/">Back to Jayesyn</a>
  </section>
</main>

<style is:global>
:root {
  --carbon: #121014;
  --carbon-deep: #0d0b10;
  --cream: #efe6d8;
  --uv: #6399bb;
  --uv-soft: #82b0cb;
  --line: #2a2333;
  --dim: #9b93a8;
  --amber: #e8a15c;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  background: var(--carbon);
  color: var(--cream);
  font-family: 'Space Grotesk', system-ui, sans-serif;
  font-size: 17px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}
a { color: var(--uv-soft); }
a:focus-visible, button:focus-visible { outline: 2px solid var(--uv-soft); outline-offset: 3px; }

/* header */
.top {
  display: flex; align-items: center; gap: 1rem;
  padding: 1.1rem clamp(1.25rem, 4vw, 3rem);
  border-bottom: 1px solid var(--line);
}
.back {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.8rem; text-decoration: none; color: var(--dim);
}
.back:hover { color: var(--cream); }
.top-name {
  font-family: 'Unbounded', sans-serif;
  font-weight: 700; font-size: 0.85rem; letter-spacing: 0.1em;
}
.top-link {
  margin-left: auto;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.8rem; text-decoration: none;
  color: var(--cream); border-bottom: 1px solid var(--uv);
  padding-bottom: 2px;
}
.top-link.muted { color: var(--dim); border-bottom-color: var(--line); }

/* hero */
.hero {
  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
  align-items: center;
  gap: clamp(2rem, 5vw, 4rem);
  padding: clamp(3rem, 8vw, 6rem) clamp(1.25rem, 4vw, 3rem);
  max-width: 1200px; margin: 0 auto;
}
.eyebrow {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--uv-soft); margin-bottom: 1rem;
}
h1 {
  font-family: 'Unbounded', sans-serif;
  font-weight: 900;
  font-size: clamp(2.2rem, 6.5vw, 4.4rem);
  line-height: 0.98; letter-spacing: -0.01em;
}
.lede { margin-top: 1.5rem; max-width: 32rem; font-size: 1.1rem; }
.cta-note {
  margin-top: 1.5rem;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.85rem;
  color: var(--dim);
}

/* composite EP cover: three live drifting bands stacked in one tile */
.ep-cover {
  position: relative; aspect-ratio: 1;
  background: var(--carbon-deep);
  border: 1px solid rgba(130, 176, 203, 0.25);
  display: flex; flex-direction: column;
  border-radius: 6px; overflow: hidden;
  container-type: inline-size;
  box-shadow: 0 26px 64px -18px rgba(0, 0, 0, 0.9), 0 0 70px -20px rgba(99, 153, 187, 0.55);
}
.cover-artist {
  font-family: 'Unbounded', sans-serif;
  font-weight: 700;
  font-size: 7.5cqw;
  color: var(--cream);
  padding: 7% 9%;
}
.ep-band {
  position: relative;
  width: 100%;
  flex: 1;
  overflow: hidden;
}
.ep-band-art {
  position: absolute;
  top: 0; left: 0;
  width: 145%;
  height: auto;
  will-change: transform;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}
.ep-band.drift-xy .ep-band-art { animation-name: drift-xy; animation-duration: 48s; }
.ep-band.drift-x .ep-band-art  { animation-name: drift-x;  animation-duration: 40s; }
.ep-band.drift-y .ep-band-art  { animation-name: drift-y;  animation-duration: 44s; }

@keyframes drift-xy {
  0%   { transform: translate(0%, -4%); }
  50%  { transform: translate(-31%, -76%); }
  100% { transform: translate(0%, -4%); }
}
@keyframes drift-x {
  0%   { transform: translate(0%, -10%); }
  50%  { transform: translate(-31%, -10%); }
  100% { transform: translate(0%, -10%); }
}
@keyframes drift-y {
  0%   { transform: translate(0%, 0%); }
  50%  { transform: translate(0%, -60%); }
  100% { transform: translate(0%, 0%); }
}

.section-h {
  font-family: 'Unbounded', sans-serif; font-weight: 700;
  font-size: clamp(1.3rem, 2.6vw, 1.8rem); margin-bottom: 1.25rem;
}

/* tracklist */
.tracklist-section {
  max-width: 1200px; margin: 0 auto;
  padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.25rem, 4vw, 3rem);
  border-top: 1px solid var(--line);
}
.tracklist {
  list-style: none;
  max-width: 36rem;
}
.track-row {
  display: flex; align-items: baseline; gap: 1.25rem;
  padding: 1rem 0;
  border-bottom: 1px solid var(--line);
}
.track-n {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.85rem; color: var(--dim);
  width: 1.5rem;
}
.track-title {
  font-size: 1.1rem;
  color: var(--cream);
  text-decoration: none;
}
a.track-title:hover { color: var(--uv-soft); }
.track-tba {
  color: var(--dim);
  font-style: italic;
}

/* bottom cta */
.bottom-cta {
  max-width: 1200px; margin: 0 auto;
  padding: clamp(3rem, 8vw, 5.5rem) clamp(1.25rem, 4vw, 3rem);
  border-top: 1px solid var(--line);
  text-align: center;
}
.bottom-cta h2 {
  font-family: 'Unbounded', sans-serif; font-weight: 900;
  font-size: clamp(1.8rem, 5vw, 3rem);
}
.bottom-cta .cta-note { margin-top: 1rem; }
.secondary-link {
  display: block; margin-top: 1.25rem;
  font-family: 'IBM Plex Mono', monospace; font-size: 0.85rem;
  color: var(--dim); text-decoration: none;
}
.secondary-link:hover { color: var(--cream); }

/* responsive */
@media (max-width: 820px) {
  .hero { grid-template-columns: 1fr; }
  .ep-cover { order: -1; }
}
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .ep-band-art { animation-duration: 90s !important; }
}
</style>

</Layout>