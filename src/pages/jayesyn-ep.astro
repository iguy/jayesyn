---
// jayesyn.com — EP page: Jayesyn (self-titled, EP 001)
// Drop this into src/pages/jayesyn-ep.astro
//
// TODOs before launch:
//   1. Confirm release date and swap into `ep.releaseDate` below.
//   2. Add the EP's hyperfollow/pre-save link once one exists (see the
//      commented-out CTA near the top of the hero — currently showing a
//      "coming soon" note instead of a dead link).
//   3. Track 4 (bonus track) needs a title, story, and lyrics — once those
//      exist this page can grow a "the story" + lyrics section just like
//      the single pages, and track 4 can link to its own page if it gets one.

const ep = {
  code: 'EP 001',
  title: 'Jayesyn',
  subtitle: 'The EP',
  releaseDate: 'TBA 2026',
};

const tracks = [
  { n: 1, title: 'Common Ground', page: '/common-ground' },
  { n: 2, title: 'One Human Rhythm', page: '/one-human-rhythm' },
  { n: 3, title: 'Music, Save Us Tonight', page: '/music-save-us-tonight' },
  { n: 4, title: 'Bonus track — TBA', page: null },
];
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Jayesyn — The EP</title>
<meta name="description" content="Jayesyn, the self-titled EP — three singles plus one new song, TBA 2026." />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href="https://jayesyn.com/jayesyn-ep" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;700;900&family=Space+Grotesk:wght@400;500&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>

<header class="top">
  <a class="back" href="/">&larr; Jayesyn</a>
  <span class="top-name">Jayesyn — The EP</span>
</header>

<main>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow">{ep.code} &middot; {ep.releaseDate}</p>
      <h1>Jayesyn</h1>
      <p class="subtitle">The EP</p>
      <p class="lede">
        Three singles and one you haven't heard yet, together for the first
        time &mdash; the four-track project that puts the whole picture in
        one place.
      </p>
      <p class="cta-note">Pre-save link coming soon.</p>
    </div>

    <!-- Signature: three artwork bands stacked into one live, animated cover —
         same drift technique as the homepage single tiles, just combined. -->
    <div class="ep-cover">
      <p class="ep-cover-title">Jayesyn</p>
      <div class="ep-band ep-band-1">
        <img class="ep-band-art" src="/art/jayesyn-music-save-us.jpeg" alt="" loading="lazy" />
      </div>
      <div class="ep-band ep-band-2">
        <img class="ep-band-art" src="/art/jayesyn-One_Human_rhythm.jpeg" alt="" loading="lazy" />
      </div>
      <div class="ep-band ep-band-3">
        <img class="ep-band-art" src="/art/jayesyn-common-ground.jpeg" alt="" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- TRACKLIST -->
  <section class="tracklist-section" aria-labelledby="tracks-h">
    <h2 id="tracks-h" class="section-h">Tracklist</h2>
    <ol class="tracklist">
      {tracks.map((t) => (
        <li class="track-row">
          {t.page ? (
            <a class="track-link" href={t.page}>
              <span class="track-n">{t.n}</span>
              <span class="track-title">{t.title}</span>
            </a>
          ) : (
            <span class="track-row-inner">
              <span class="track-n">{t.n}</span>
              <span class="track-title track-title-tba">{t.title}</span>
            </span>
          )}
        </li>
      ))}
    </ol>
  </section>

  <!-- BOTTOM CTA -->
  <section class="bottom-cta">
    <h2>Out {ep.releaseDate}.</h2>
    <p class="cta-note">Pre-save link coming soon.</p>
    <a class="secondary-link" href="/">Back to Jayesyn</a>
  </section>
</main>

<footer class="foot">
  <p class="foot-name">Jayesyn</p>
  <p class="foot-meta">
    Los Angeles, CA &middot; Booking &amp; press:
    <a href="mailto:garycrossey@irishguy.us">garycrossey@irishguy.us</a>
  </p>
  <p class="foot-credit">
    Released via <a href="https://irishguydesign.studio" rel="noopener">Irishguy Design Studio</a>
    &middot; &copy; {new Date().getFullYear()} Jayesyn. All rights reserved.
  </p>
</footer>

<style is:global>
:root {
  --carbon: #121014;
  --carbon-deep: #0d0b10;
  --cream: #efe6d8;
  --uv: #6399bb;
  --uv-soft: #82b0cb;
  --line: #2a2333;
  --dim: #9b93a8;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  background: var(--carbon);
  color: var(--cream);
  font-family: 'Space Grotesk', system-ui, sans-serif;
  font-size: 17px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}
a { color: var(--uv-soft); }
a:focus-visible, button:focus-visible { outline: 2px solid var(--uv-soft); outline-offset: 3px; }

/* header */
.top {
  display: flex; align-items: center; gap: 1rem;
  padding: 1.1rem clamp(1.25rem, 4vw, 3rem);
  border-bottom: 1px solid var(--line);
}
.back {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.8rem; text-decoration: none; color: var(--dim);
}
.back:hover { color: var(--cream); }
.top-name {
  font-family: 'Unbounded', sans-serif;
  font-weight: 700; font-size: 0.85rem; letter-spacing: 0.1em;
}

/* hero */
.hero {
  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
  align-items: center;
  gap: clamp(2rem, 5vw, 4rem);
  padding: clamp(3rem, 8vw, 6rem) clamp(1.25rem, 4vw, 3rem);
  max-width: 1200px; margin: 0 auto;
}
.eyebrow {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--uv-soft); margin-bottom: 1rem;
}
h1 {
  font-family: 'Unbounded', sans-serif;
  font-weight: 900;
  font-size: clamp(2.6rem, 8vw, 5.5rem);
  line-height: 0.98; letter-spacing: -0.01em;
}
.subtitle {
  font-family: 'Unbounded', sans-serif;
  font-weight: 700; font-size: clamp(1rem, 2vw, 1.3rem);
  color: var(--uv-soft);
  margin-top: 0.4rem;
}
.lede { margin-top: 1.5rem; max-width: 32rem; font-size: 1.1rem; }
.cta-note {
  margin-top: 1.5rem;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.85rem; color: var(--dim);
}

/* EP cover: three live, drifting artwork bands stacked in one tile */
.ep-cover {
  position: relative;
  aspect-ratio: 1;
  background: var(--carbon-deep);
  border: 1px solid rgba(130, 176, 203, 0.25);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  container-type: inline-size;
  box-shadow:
    0 26px 64px -18px rgba(0, 0, 0, 0.9),
    0 0 70px -20px rgba(99, 153, 187, 0.55);
}
.ep-cover-title {
  font-family: 'Unbounded', sans-serif;
  font-weight: 700;
  font-size: 9cqw;
  color: var(--cream);
  padding: 7% 8% 4%;
}
.ep-band {
  position: relative;
  flex: 1;
  overflow: hidden;
}
.ep-band-art {
  position: absolute;
  top: 0; left: 0;
  will-change: transform;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}
.ep-band-1 .ep-band-art {
  width: 145%; height: auto;
  animation-name: drift-xy; animation-duration: 48s;
}
.ep-band-2 .ep-band-art {
  width: 165%; height: auto;
  animation-name: drift-x; animation-duration: 36s;
}
.ep-band-3 .ep-band-art {
  width: 100%; height: auto;
  animation-name: drift-y; animation-duration: 40s;
}
@keyframes drift-y {
  0%   { transform: translateY(-2%); }
  50%  { transform: translateY(-82%); }
  100% { transform: translateY(-2%); }
}
@keyframes drift-x {
  0%   { transform: translateY(-30%) translateX(0%); }
  50%  { transform: translateY(-30%) translateX(-39%); }
  100% { transform: translateY(-30%) translateX(0%); }
}
@keyframes drift-xy {
  0%   { transform: translate(0%, -4%); }
  50%  { transform: translate(-31%, -76%); }
  100% { transform: translate(0%, -4%); }
}

/* tracklist */
.tracklist-section {
  max-width: 1200px; margin: 0 auto;
  padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.25rem, 4vw, 3rem);
  border-top: 1px solid var(--line);
}
.section-h {
  font-family: 'Unbounded', sans-serif; font-weight: 700;
  font-size: clamp(1.4rem, 3vw, 2rem); margin-bottom: 1.75rem;
}
.tracklist {
  list-style: none;
  max-width: 34rem;
  border-top: 1px solid var(--line);
}
.track-row { border-bottom: 1px solid var(--line); }
.track-link, .track-row-inner {
  display: flex; align-items: baseline; gap: 1rem;
  padding: 1.1rem 0.25rem;
  text-decoration: none; color: inherit;
}
.track-link:hover .track-title { color: var(--uv-soft); }
.track-n {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.85rem; color: var(--dim);
  width: 1.5rem;
}
.track-title {
  font-size: 1.05rem; font-weight: 500;
  transition: color 160ms ease;
}
.track-title-tba { color: var(--dim); font-weight: 400; font-style: italic; }

/* bottom cta */
.bottom-cta {
  max-width: 1200px; margin: 0 auto;
  padding: clamp(3rem, 8vw, 5.5rem) clamp(1.25rem, 4vw, 3rem);
  border-top: 1px solid var(--line);
  text-align: center;
}
.bottom-cta h2 {
  font-family: 'Unbounded', sans-serif; font-weight: 900;
  font-size: clamp(1.8rem, 5vw, 3rem);
}
.bottom-cta .cta-note { margin-top: 1rem; }
.secondary-link {
  display: block; margin-top: 1.25rem;
  font-family: 'IBM Plex Mono', monospace; font-size: 0.85rem;
  color: var(--dim); text-decoration: none;
}
.secondary-link:hover { color: var(--cream); }

/* footer */
.foot { border-top: 1px solid var(--line); padding: 2.5rem clamp(1.25rem, 4vw, 3rem) 3rem; text-align: center; }
.foot-name { font-family: 'Unbounded', sans-serif; font-weight: 700; font-size: 0.9rem; letter-spacing: 0.2em; }
.foot-meta { margin-top: 0.75rem; font-size: 0.9rem; color: var(--dim); }
.foot-credit { margin-top: 0.5rem; font-family: 'IBM Plex Mono', monospace; font-size: 0.75rem; color: var(--dim); }

/* responsive */
@media (max-width: 820px) {
  .hero { grid-template-columns: 1fr; }
  .ep-cover { order: -1; }
}
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .ep-band-art { animation-duration: 90s !important; }
}
</style>

</body>
</html>