---
// jayesyn.com — homepage
// Placeholders to replace before launch are marked TODO.
//
// ARTWORK FILES in /public/art/ — these must be the FULL SQUARE paintings (no text baked in):
//   jayesyn-common-ground.jpeg      (blue/green pour)
//   jayesyn-One_Human_rhythm.jpeg   (red/pink marble)
//   jayesyn-music-save-us.jpeg      (purple/coral cells)
//     ^ TODO: rename "jayesyn-music save us.jpeg" → "jayesyn-music-save-us.jpeg" (no spaces in web filenames)
// The cover bands crop them to a strip and slowly drift through the rest of the canvas.

const releases = [
  { code: 'SGL 001', title: 'Common Ground', date: 'August 12, 2026', status: 'Scheduled', link: 'https://distrokid.com/hyperfollow/jayesyn/common-ground', page: '/common-ground' },
  { code: 'SGL 002', title: 'One Human Rhythm', date: 'September 8, 2026', status: 'Scheduled', link: 'https://distrokid.com/hyperfollow/jayesyn/one-human-rhythm', page: '/one-human-rhythm' },
  { code: 'SGL 003', title: 'Music, Save Us Tonight', date: 'October 6, 2026', status: 'Scheduled', link: 'https://distrokid.com/hyperfollow/jayesyn/music-save-us-tonight', page: '/music-save-us-tonight' },
  { code: 'EP 001', title: 'Four-Track EP', date: 'TBA 2026', status: 'In production', page: '/jayesyn-ep' },
  { code: 'RMX 001', title: 'Remix Project', date: 'TBA 2027', status: 'Planned' },
  { code: 'VNL 001', title: 'EP on Vinyl', date: 'TBA 2027', status: 'Planned' },
];

// Single covers rendered live in HTML — text stays selectable, artwork drifts.
// drift: 'y' = up/down · 'x' = across · 'xy' = slow diagonal — each cover moves differently.
const covers = [
  {
    title: ['Common', 'Ground'],
    art: '/art/jayesyn-common-ground.jpeg',
    drift: 'y',
    link: 'https://distrokid.com/hyperfollow/jayesyn/common-ground',
    page: '/common-ground',
  },
  {
    title: ['One Human', 'Rhythm'],
    art: '/art/jayesyn-One_Human_rhythm.jpeg',
    drift: 'x',
    link: 'https://distrokid.com/hyperfollow/jayesyn/one-human-rhythm',
    page: '/one-human-rhythm',
  },
  {
    title: ['Music, Save', 'Us Tonight'],
    art: '/art/jayesyn-music-save-us.jpeg',
    drift: 'xy',
    link: 'https://distrokid.com/hyperfollow/jayesyn/music-save-us-tonight',
    page: '/music-save-us-tonight',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  name: 'Jayesyn',
  url: 'https://jayesyn.com',
  genre: 'Electronic', // TODO: confirm genre with artist
  foundingLocation: {
    '@type': 'Place',
    name: 'Los Angeles, California',
  },
  member: {
    '@type': 'Person',
    name: 'Jason Thomas Nelson',
  },
  // TODO: add sameAs array once platform profiles are live:
  // sameAs: ['https://open.spotify.com/artist/...', 'https://music.apple.com/...', ...]
};
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Jayesyn — Three singles. One EP. Remixes. Vinyl.</title>
<meta name="description" content="Jayesyn is a Los Angeles artist releasing three singles, a four-track EP, a remix project, and a vinyl pressing. Hear it first — join the list." />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href="https://jayesyn.com/" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;700;900&family=Space+Grotesk:wght@400;500&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>

<header class="top">
  <span class="mark" aria-hidden="true"></span>
  <span class="top-name">Jayesyn</span>
  <a class="top-link" href="#signup">Join the list</a>
</header>

<main>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg-shape" aria-hidden="true"></div>
    <div class="hero-inner">
    <div class="hero-text">
      <p class="eyebrow">Los Angeles &middot; New project</p>
      <h1>Jayesyn</h1>
      <p class="lede">
        <span class="brand-name">Jayesyn</span> lives somewhere between soulful
        house and art pop &mdash; downtempo, electronic, and deeply human, with
        a hopeful, unifying message. It starts with that voice: smooth, honeyed,
        and exceptionally clear. He draws you in close with an intimate, slightly
        breathy delivery in the verses, then opens up into something powerful,
        resonant, and passionate when the chorus arrives. And when he stacks his
        own harmonies into rich, choir-like layers, you hear exactly what
        he&rsquo;s after: something communal, something heartfelt.
      </p>
      <p class="lede-detail">
        His production is clean, polished, and atmospheric &mdash; trip-hop
        patience with a soulful pulse. He locks a groovy, melodic bass line into
        a steady downtempo pocket, lays gentle electric piano underneath, and
        lets a standout trumpet carry a poignant, memorable melody through the
        intro and instrumental breaks. He leaves the atmosphere wide and
        spacious &mdash; subtle synth pads, a generous wash of reverb.
      </p>
      
    </div>

    <!-- Signature: rotating record-label disc -->
    <div class="disc-wrap">
      <div class="disc-glow" aria-hidden="true"></div>
      <div class="disc-rotor">
      <svg class="disc" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Jayesyn record — plays a snippet of Common Ground">
        <defs>
          <path id="ringpath" d="M 200,200 m -132,0 a 132,132 0 1,1 264,0 a 132,132 0 1,1 -264,0" />
          <radialGradient id="sheen" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#1a1620" stop-opacity="0" />
            <stop offset="62%" stop-color="#1a1620" stop-opacity="0" />
            <stop offset="63%" stop-color="#3b3550" stop-opacity="0.55" />
            <stop offset="66%" stop-color="#1a1620" stop-opacity="0" />
            <stop offset="100%" stop-color="#1a1620" stop-opacity="0" />
          </radialGradient>
        </defs>

        <!-- vinyl body -->
        <circle cx="200" cy="200" r="198" fill="#0D0B10" />
        <circle cx="200" cy="200" r="198" fill="none" stroke="#231d2e" stroke-width="1" />

        <!-- concentric grooves: fine rings that make the spin readable -->
        <g fill="none" stroke="#1c1826" stroke-width="0.75">
          <circle cx="200" cy="200" r="192" /><circle cx="200" cy="200" r="187" />
          <circle cx="200" cy="200" r="182" /><circle cx="200" cy="200" r="177" />
          <circle cx="200" cy="200" r="172" /><circle cx="200" cy="200" r="167" />
          <circle cx="200" cy="200" r="162" /><circle cx="200" cy="200" r="157" />
          <circle cx="200" cy="200" r="152" /><circle cx="200" cy="200" r="147" />
          <circle cx="200" cy="200" r="142" /><circle cx="200" cy="200" r="137" />
        </g>

        <!-- a single brighter groove + rotating light sheen give a sense of motion -->
        <circle cx="200" cy="200" r="150" fill="none" stroke="#2e2740" stroke-width="1" />
        <circle class="disc-sheen" cx="200" cy="200" r="198" fill="url(#sheen)" />

        <!-- label -->
        <circle cx="200" cy="200" r="120" fill="#EFE6D8" />
        <circle cx="200" cy="200" r="119" fill="none" stroke="#121014" stroke-width="2" />
        <circle cx="200" cy="200" r="123" fill="none" stroke="#0d0b10" stroke-width="2" />

        <text class="ring-text">
          <textPath href="#ringpath" startOffset="0">
            THREE SINGLES &#183; ONE EP &#183; REMIX PROJECT &#183; VINYL &#183; ORIGINAL ARTWORK &#183;&nbsp;
          </textPath>
        </text>
        <text x="200" y="188" text-anchor="middle" class="label-name">Jayesyn</text>
        <text x="200" y="216" text-anchor="middle" class="label-sub">JSN&#8211;001 &#183; 33&#8531; RPM</text>
        <text x="200" y="238" text-anchor="middle" class="label-sub">STEREO</text>

        <!-- spindle -->
        <circle cx="200" cy="200" r="7" fill="#0d0b10" />
        <circle cx="200" cy="200" r="2.5" fill="#231d2e" />
      </svg>
      </div>
      <p class="disc-hint">Hover or tap to preview &mdash; sound unlocks after your first click on the page</p>
    </div>
    </div>
  </section>

  <!-- RELEASE SEQUENCE -->
  <section class="releases" aria-labelledby="rel-h">
    <div class="releases-inner">
      <h2 id="rel-h" class="section-h">The sequence</h2>
      <ol class="rel-track">
        {releases.map((r) => {
          const href = r.page || r.link;
          const external = !r.page && !!r.link;
          const showPresave = !!r.page && !!r.link;
          return (
            <li class="rel-card">
              {href ? (
                <a class="rel-top" href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
                  <span class="rel-code">{r.code}</span>
                  <span class="rel-title">{r.title}</span>
                  <span class="rel-meta">{r.date} &middot; {r.status}</span>
                </a>
              ) : (
                <div class="rel-top rel-top-static">
                  <span class="rel-code">{r.code}</span>
                  <span class="rel-title">{r.title}</span>
                  <span class="rel-meta">{r.date} &middot; {r.status}</span>
                </div>
              )}
              {showPresave && (
                <a class="rel-presave" href={r.link} target="_blank" rel="noopener">Pre-save &rarr;</a>
              )}
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <!-- ARTWORK / SINGLE COVERS -->
  <section class="art" aria-labelledby="art-h">
    <h2 id="art-h" class="section-h">The singles</h2>
    <p class="art-lede">
      Three singles, released over three months &mdash; then a new EP.
    </p>
    <div class="covers">
      {covers.map((c) => {
        const href = c.page || c.link;
        const external = !c.page && !!c.link;
        return (
          <a class={`cover drift-${c.drift}`} href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
            <p class="cover-artist">Jayesyn</p>
            <div class="cover-band">
              <img class="cover-art" src={c.art} alt="" loading="lazy" />
            </div>
            <h3 class="cover-title">
              {c.title[0]}<br />{c.title[1]}
            </h3>
          </a>
        );
      })}
    </div>
  </section>

  <!-- SIGNUP -->
  <section class="signup" id="signup" aria-labelledby="signup-h">
    <h2 id="signup-h">Hear it first.</h2>
    <p>One email when each release drops. Nothing else.</p>
    <form action="https://formspree.io/f/xpqvdjyb" method="post">
      <label class="visually-hidden" for="email">Email address</label>
      <input id="email" type="email" name="email" placeholder="you@example.com" required />
      <button type="submit">Join the list</button>
    </form>
  </section>
</main>

<footer class="foot">
  <p class="foot-name">Jayesyn</p>
  <p class="foot-meta">
    Los Angeles, CA &middot; Booking &amp; press:
    <a href="mailto:garycrossey@irishguy.us">garycrossey@irishguy.us</a>
  </p>
  <p class="foot-credit">
    Released via <a href="https://irishguydesign.studio" rel="noopener">Irishguy Design Studio</a>
    &middot; &copy; {new Date().getFullYear()} Jayesyn. All rights reserved.
  </p>
</footer>

<style is:global>
:root {
  --carbon: #121014;
  --carbon-deep: #0d0b10;
  --cream: #efe6d8;
  --uv: #6399bb;
  --uv-soft: #82b0cb;
  --line: #2a2333;
  --dim: #9b93a8;
  --brand-blue: #6399bc;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

body {
  background: var(--carbon);
  color: var(--cream);
  font-family: 'Space Grotesk', system-ui, sans-serif;
  font-size: 17px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

.visually-hidden {
  position: absolute; width: 1px; height: 1px;
  overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;
}

a { color: var(--uv-soft); }
a:focus-visible, button:focus-visible, input:focus-visible {
  outline: 2px solid var(--uv-soft);
  outline-offset: 3px;
}

/* ---------- header ---------- */
.top {
  display: flex; align-items: center; gap: 0.75rem;
  padding: 1.1rem clamp(1.25rem, 4vw, 3rem);
  border-bottom: 1px solid var(--line);
}
.mark {
  width: 18px; height: 18px; border-radius: 50%;
  border: 3px solid var(--uv);
}
.top-name {
  font-family: 'Unbounded', sans-serif;
  font-weight: 700; font-size: 0.85rem; letter-spacing: 0.18em;
}
.top-link {
  margin-left: auto;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.8rem; text-decoration: none;
  color: var(--cream); border-bottom: 1px solid var(--uv);
  padding-bottom: 2px;
}
.top-link:hover { color: var(--uv-soft); }

/* ---------- hero ---------- */
.hero {
  position: relative;
  overflow: hidden;
}
.hero-bg-shape {
  position: absolute;
  top: 0; left: 0; right: 0;
  bottom: -2px;
  background: var(--brand-blue);
  clip-path: polygon(66% 0%, 100% 0%, 100% 100%, 56% 100%);
  z-index: 0;
  pointer-events: none;
}
.hero-inner {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
  align-items: center;
  gap: clamp(2rem, 5vw, 4rem);
  padding: clamp(3rem, 8vw, 6rem) clamp(1.25rem, 4vw, 3rem);
  max-width: 1200px; margin: 0 auto;
}
.eyebrow {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.8rem; letter-spacing: 0.12em;
  text-transform: uppercase; color: var(--uv-soft);
  margin-bottom: 1rem;
}
h1 {
  font-family: 'Unbounded', sans-serif;
  font-weight: 900;
  font-size: clamp(2.2rem, 8.5vw, 6.5rem);
  line-height: 0.95;
  letter-spacing: -0.01em;
  white-space: nowrap;
}
.lede {
  margin-top: 1.5rem;
  max-width: 34rem;
  color: var(--cream);
  font-size: 1.1rem;
}
.lede-detail {
  margin-top: 1.1rem;
  max-width: 30rem;
  color: var(--dim);
  font-size: 0.95rem;
}
.brand-name {
  font-family: 'Unbounded', sans-serif;
  font-weight: 700;
  font-size: 0.82em; /* Unbounded runs large; this optically matches the body text size */
}
.cta {
  display: inline-block;
  margin-top: 2rem;
  font-family: 'Unbounded', sans-serif;
  font-weight: 700; font-size: 0.85rem;
  text-decoration: none;
  background: var(--uv);
  color: var(--cream);
  padding: 0.9rem 1.6rem;
  border-radius: 999px;
  transition: background 160ms ease;
}
.cta:hover { background: var(--uv-soft); }

/* signature disc */
.disc-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.1rem;
  position: relative;
}
/* Glow: pure radial gradient, no blur filter (blur layers can show square edges).
   Sits behind the rotor, never rotates, never resizes. */
.disc-glow {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: min(440px, 88vw);
  aspect-ratio: 1;
  border-radius: 50%;
  background: radial-gradient(circle,
    rgba(99, 153, 187, 0.30) 0%,
    rgba(99, 153, 187, 0.12) 45%,
    rgba(99, 153, 187, 0) 70%);
  opacity: 0.8;
  transition: opacity 400ms ease;
  pointer-events: none;
  z-index: 0;
}
.disc-wrap.playing .disc-glow {
  opacity: 1;
}
/* The rotor is a plain div — rotating a div is reliable everywhere,
   unlike animating transform directly on an <svg>. */
.disc-rotor {
  position: relative;
  z-index: 1;
  width: min(400px, 80vw);
  aspect-ratio: 1;
  animation: spin 4s linear infinite;
  transform-origin: 50% 50%;
  cursor: pointer;
  /* NOTE: no transition on this element — anything transitioning transform
     here will fight the rotation and cause snapping. Speed changes are done
     smoothly in JS via the Web Animations API, never by swapping duration. */
}
.disc {
  display: block;
  width: 100%;
  height: 100%;
}
@keyframes spin { to { transform: rotate(-360deg); } }
.disc-hint {
  max-width: 22rem;
  text-align: center;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.75rem; letter-spacing: 0.04em;
  color: rgba(13, 11, 16, 0.7);
  transition: opacity 400ms ease;
}
.disc-hint.unlocked {
  opacity: 0.75;
}
.ring-text {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 15px; letter-spacing: 0.28em;
  fill: var(--uv-soft);
}
.label-name {
  font-family: 'Unbounded', sans-serif;
  font-weight: 900; font-size: 34px;
  fill: var(--carbon);
}
.label-sub {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 12px; letter-spacing: 0.14em;
  fill: var(--carbon);
}

/* ---------- releases ---------- */
.section-h {
  font-family: 'Unbounded', sans-serif;
  font-weight: 700;
  font-size: clamp(1.4rem, 3vw, 2rem);
  margin-bottom: 1.75rem;
}
.releases {
  background: var(--brand-blue);
}
.releases-inner {
  max-width: 1200px; margin: 0 auto;
  padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.25rem, 4vw, 3rem);
}
.rel-track {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
  gap: 1px;
  background: var(--line);
  border: 1px solid var(--line);
}
.rel-card {
  background: var(--carbon-deep);
  display: flex; flex-direction: column;
}
.rel-top {
  display: flex; flex-direction: column; gap: 0.45rem;
  padding: 1.25rem 1.1rem 1.1rem;
  color: inherit; text-decoration: none;
  transition: background 160ms ease;
}
a.rel-top:hover {
  background: rgba(130, 176, 203, 0.2);
}
.rel-code {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.75rem; letter-spacing: 0.12em;
  color: var(--uv-soft);
}
.rel-title { font-weight: 500; }
.rel-meta {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.72rem; color: var(--dim);
}
.rel-presave {
  display: block;
  padding: 0.85rem 1.1rem 1.1rem;
  border-top: 1px solid var(--line);
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.72rem; letter-spacing: 0.06em;
  color: var(--uv-soft);
  text-decoration: none;
  transition: background 160ms ease, color 160ms ease;
}
.rel-presave:hover {
  background: rgba(130, 176, 203, 0.2);
  color: var(--cream);
}

/* ---------- art / single covers ---------- */
.art {
  max-width: 1200px; margin: 0 auto;
  padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.25rem, 4vw, 3rem);
  border-top: 1px solid var(--line);
}
.art-lede { color: var(--dim); max-width: 36rem; margin-bottom: 1.75rem; }

.covers {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
  gap: 1.5rem;
}

/* Each cover is a live square: real text top + bottom, artwork strip through the middle */
.cover {
  position: relative;
  aspect-ratio: 1;
  background: var(--carbon-deep);
  border: 1px solid rgba(130, 176, 203, 0.25);
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
  container-type: inline-size; /* lets the type scale with the tile, like a printed cover */
  box-shadow:
    0 18px 50px -20px rgba(0, 0, 0, 0.9),
    0 0 60px -22px rgba(99, 153, 187, 0.55); /* UV glow lifts the tile off the black */
  transition: box-shadow 320ms ease, transform 320ms ease, border-color 320ms ease;
  color: inherit;
  text-decoration: none;
}
.cover:hover {
  transform: translateY(-4px);
  border-color: rgba(130, 176, 203, 0.5);
  box-shadow:
    0 26px 64px -18px rgba(0, 0, 0, 0.95),
    0 0 90px -14px rgba(99, 153, 187, 0.8);
}
.cover-artist {
  font-family: 'Unbounded', sans-serif;
  font-weight: 700;
  font-size: 7.5cqw;
  color: var(--cream);
  padding: 0 9%;
  margin-bottom: 5.5%;
}
.cover-title {
  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-weight: 700;
  font-size: 11cqw;
  line-height: 1.04;
  letter-spacing: -0.01em;
  text-transform: uppercase;
  color: var(--cream);
  padding: 0 9%;
  margin-top: 7%;
}

/* The artwork band: a strip-shaped window onto the full square painting.
   The painting is much larger than the window, and drifts through it. */
.cover-band {
  position: relative;
  width: 100%;
  height: 17.5%;
  overflow: hidden;
}
.cover-art {
  position: absolute;
  top: 0; left: 0;
  will-change: transform;
  animation-timing-function: linear; /* constant speed — never eases to a stop */
  animation-iteration-count: infinite;
}

/* drift-y — Common Ground: sinks then rises, looping seamlessly. */
.drift-y .cover-art {
  width: 100%;
  height: auto;
  animation-name: drift-y;
  animation-duration: 40s;
}
@keyframes drift-y {
  0%   { transform: translateY(-2%); }
  50%  { transform: translateY(-82%); }
  100% { transform: translateY(-2%); }
}

/* drift-x — One Human Rhythm: drifts across and back, looping seamlessly. */
.drift-x .cover-art {
  width: 165%;
  height: auto;
  animation-name: drift-x;
  animation-duration: 36s;
}
@keyframes drift-x {
  0%   { transform: translateY(-30%) translateX(0%); }
  50%  { transform: translateY(-30%) translateX(-39%); }
  100% { transform: translateY(-30%) translateX(0%); }
}

/* drift-xy — Music, Save Us Tonight: diagonal wander out and back, looping seamlessly. */
.drift-xy .cover-art {
  width: 145%;
  height: auto;
  animation-name: drift-xy;
  animation-duration: 48s;
}
@keyframes drift-xy {
  0%   { transform: translate(0%, -4%); }
  50%  { transform: translate(-31%, -76%); }
  100% { transform: translate(0%, -4%); }
}

/* ---------- signup ---------- */
.signup {
  max-width: 720px; margin: 0 auto;
  padding: clamp(3rem, 8vw, 5.5rem) clamp(1.25rem, 4vw, 3rem);
  text-align: center;
}
.signup h2 {
  font-family: 'Unbounded', sans-serif;
  font-weight: 900;
  font-size: clamp(1.8rem, 5vw, 3rem);
}
.signup p { color: var(--dim); margin-top: 0.75rem; }
.signup form {
  margin-top: 2rem;
  display: flex; gap: 0.6rem; justify-content: center; flex-wrap: wrap;
}
.signup input[type='email'] {
  flex: 1 1 260px; max-width: 340px;
  background: var(--carbon-deep);
  border: 1px solid var(--line);
  border-radius: 999px;
  color: var(--cream);
  font-family: 'Space Grotesk', sans-serif;
  font-size: 1rem;
  padding: 0.85rem 1.25rem;
}
.signup input::placeholder { color: var(--dim); }
.signup button {
  font-family: 'Unbounded', sans-serif;
  font-weight: 700; font-size: 0.85rem;
  background: var(--uv); color: var(--cream);
  border: 0; border-radius: 999px;
  padding: 0.85rem 1.5rem;
  cursor: pointer;
  transition: background 160ms ease;
}
.signup button:hover { background: var(--uv-soft); }
.hp { position: absolute; left: -5000px; }

/* ---------- footer ---------- */
.foot {
  border-top: 1px solid var(--line);
  padding: 2.5rem clamp(1.25rem, 4vw, 3rem) 3rem;
  text-align: center;
}
.foot-name {
  font-family: 'Unbounded', sans-serif;
  font-weight: 700; font-size: 0.9rem; letter-spacing: 0.2em;
}
.foot-meta { margin-top: 0.75rem; font-size: 0.9rem; color: var(--dim); }
.foot-credit {
  margin-top: 0.5rem;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.75rem; color: var(--dim);
}

/* ---------- responsive & motion ---------- */
@media (max-width: 820px) {
  .hero-inner { grid-template-columns: 1fr; }
  .hero-bg-shape { display: none; }
  .disc-wrap { order: -1; }
  .disc-rotor { width: min(300px, 70vw); }
  .disc-glow { width: min(330px, 77vw); }
}
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  /* Don't freeze entirely — just slow everything to a calm, non-distracting pace. */
  .disc-rotor { animation-duration: 9s; }
  .drift-y .cover-art  { animation-duration: 90s; }
  .drift-x .cover-art  { animation-duration: 85s; }
  .drift-xy .cover-art { animation-duration: 100s; }
}
</style>

<audio id="record-audio" preload="auto" loop>
  <source src="/common-ground-sample.m4a" type="audio/mp4" />
  <source src="/common-ground-sample.mp3" type="audio/mpeg" />
</audio>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var audio = document.getElementById('record-audio');
    var discWrap = document.querySelector('.disc-wrap');
    var rotor = document.querySelector('.disc-rotor');
    var cta = document.querySelector('.cta');
    var hint = document.querySelector('.disc-hint');
    if (!audio || !discWrap || !rotor) return;

    // The browser blocks audio until the visitor's first click anywhere on
    // the page — this just updates the hint copy once that's happened, so
    // people aren't left wondering why hover was silent the first time.
    if (hint) {
      document.addEventListener('click', function unlock() {
        hint.textContent = 'Hover or tap to preview';
        hint.classList.add('unlocked');
        document.removeEventListener('click', unlock);
      }, { once: true });
    }

    // Grab the CSS spin animation so we can change its speed smoothly.
    // updatePlaybackRate preserves the current angle — no snap, ever.
    var spinAnim = null;
    function getSpin() {
      if (!spinAnim) {
        var anims = rotor.getAnimations ? rotor.getAnimations() : [];
        spinAnim = anims.length ? anims[0] : null;
      }
      return spinAnim;
    }

    // Surfaces the *real* reason playback fails in the console — either the
    // browser's autoplay gate (expected, harmless) or a genuine load error
    // (file missing/404/wrong path — check this first if audio never plays).
    audio.addEventListener('error', function () {
      var err = audio.error;
      console.error(
        '[record audio] failed to load. Check that the file is committed ' +
        'from /public/ (not just /dist/) and that visiting the URL directly ' +
        '(e.g. yoursite.com/common-ground-sample.m4a) does not 404. Error code:',
        err && err.code
      );
    });

    function startPlayback() {
      var p = audio.play();
      if (p && typeof p.catch === 'function') {
        p.catch(function (err) {
          // Blocked until the visitor's first click/tap (browser autoplay policy) —
          // expected on a fresh page load, not a bug. If this fires *every* time,
          // including after a click, the console 'error' listener above will show
          // the real cause.
          console.warn('[record audio] play() rejected:', err && err.message);
        });
      }
      discWrap.classList.add('playing');
      var s = getSpin();
      if (s && s.updatePlaybackRate) s.updatePlaybackRate(2.22); /* 4s ÷ 2.22 ≈ 1.8s = 33⅓ RPM */
    }

    function stopPlayback() {
      audio.pause();
      discWrap.classList.remove('playing');
      var s = getSpin();
      if (s && s.updatePlaybackRate) s.updatePlaybackRate(1); /* glide back to idle speed */
    }

    // Hover the record: play while hovering, pause on leave
    discWrap.addEventListener('mouseenter', startPlayback);
    discWrap.addEventListener('mouseleave', stopPlayback);

    // Click/tap the record: toggle (also the mobile path, since phones have no hover)
    discWrap.addEventListener('click', function () {
      audio.paused ? startPlayback() : stopPlayback();
    });

    // Hover the "Hear the first single early" button: same behavior
    if (cta) {
      cta.addEventListener('mouseenter', startPlayback);
      cta.addEventListener('mouseleave', stopPlayback);
      // Clicking the CTA still scrolls to #signup — that click also unlocks audio.
      cta.addEventListener('click', startPlayback);
    }
  });
</script>

</body>
</html>