---
// jayesyn.com — single page: Common Ground (SGL 001)
// Drop this into src/pages/common-ground.astro
//
// TODOs before launch, all marked below:
//   1. Paste full lyrics into the LYRICS array (same section/lines structure as the other single pages).
//   2. Confirm/replace the "song story" paragraph — it's drafted from the DescribeMusic
//      analysis, in your voice, but you know the real story better than any tool does.
//
// NOTE: the audio player was intentionally removed — the song isn't out yet, so there's
// nothing to stream.
//
// NOTE: genre is labeled "Soul Pop" here, not the analyzer's raw "Contemporary R&B / Soul Pop" —
// Jason doesn't want the R&B label used anywhere on the site.

const song = {
  code: 'SGL 001',
  title: 'Common Ground',
  releaseDate: 'August 12, 2026',
  // Pre-launch: this hyperfollow link collects pre-saves. After release day,
  // swap this to the song's permanent streaming link and change ctaLabel below
  // from 'Pre-save on all platforms' to 'Stream now' (both CTA buttons on this
  // page pull from these two values, so this is the only place to edit).
  hyperfollow: 'https://distrokid.com/hyperfollow/jayesyn/common-ground',
  ctaLabel: 'Pre-save on all platforms',
  art: '/art/jayesyn-common-ground.jpeg',
  genre: 'Soul Pop',
  bpm: 94,
  key: 'C# minor',
  tags: ['soul-pop', 'hopeful', 'reflective', 'uplifting', 'calm', 'male vocals', 'strings', 'mid-tempo'],
};

// Straight from the track's own audio analysis — used below to draw the mood chart.
const moods = [
  { label: 'Energetic', value: 50 },
  { label: 'Excited', value: 30 },
  { label: 'Happy', value: 60 },
  { label: 'Calm', value: 80 },
  { label: 'Peaceful', value: 70 },
  { label: 'Relaxed', value: 70 },
  { label: 'Sad', value: 20 },
  { label: 'Tense', value: 10 },
  { label: 'Melancholic', value: 40 },
  { label: 'Angry', value: 0 },
];

// Precomputed 10-axis radar polygon (200x200 viewBox, center 100,100).
// r = 8 + (value/100)*80, angles at 36° steps starting from top, clockwise.
// This song's shape leans toward Calm/Peaceful/Relaxed rather than the energetic
// peak on the other two singles' pages — a deliberately different silhouette.
const radarPoints = '100,52 118.8,74.1 153.3,82.7 168.5,122.2 137.6,151.8 100,164 85.9,119.4 84.8,104.9 61.9,87.6 95.3,93.5';

// TODO: paste full lyrics here, same shape as the other single pages:
// [{ section: 'Verse', lines: ['line one', 'line two', ...] }, ...]
const LYRICS = [
  {
    section: 'TODO',
    lines: ['Paste the full lyrics here as { section, lines } blocks — see one-human-rhythm.astro for the format.'],
  },
];
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Common Ground — Jayesyn</title>
<meta name="description" content="Common Ground — Jayesyn. A hopeful, reflective soul-pop single about finding shared footing, out August 12, 2026." />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href="https://jayesyn.com/common-ground" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;700;900&family=Space+Grotesk:wght@400;500&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>

<header class="top">
  <a class="back" href="/">&larr; Jayesyn</a>
  <span class="top-name">Common Ground</span>
  <a class="top-link" href={song.hyperfollow} target="_blank" rel="noopener">Pre-save</a>
</header>

<main>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow">{song.code} &middot; {song.releaseDate}</p>
      <h1>Common<br />Ground</h1>
      <p class="lede">
        A quiet, unhurried soul-pop single about finding the footing two
        people can actually stand on together &mdash; less an anthem, more a
        conversation.
      </p>
      <div class="tag-row">
        {song.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
      <a class="cta" href={song.hyperfollow} target="_blank" rel="noopener">{song.ctaLabel}</a>
    </div>

    <div class="art-wrap">
      <img class="art-img" src={song.art} alt="Common Ground single artwork" />
    </div>
  </section>

  <!-- STORY + SOUND -->
  <section class="story" aria-labelledby="story-h">
    <div class="story-text">
      <h2 id="story-h" class="section-h">The story</h2>
      <p>
        Where the other two singles reach up and out, this song stays close.
        The verses are almost whispered, drawing you in rather than calling
        across a room, before the chorus opens into something fuller &mdash;
        layered harmonies stacking like a small choir behind him, warm rather
        than triumphant.
      </p>
      <p>
        Underneath, a groovy, melodic bassline and a steady mid-tempo pulse
        keep things relaxed rather than driving, while a recurring violin
        line threads through the intro and instrumental breaks, adding a
        touch of classical elegance to the soul-pop foundation. It's the most
        reflective of the three songs &mdash; written for sitting with
        someone, not moving a crowd.
      </p>
    </div>

    <div class="mood-card">
      <p class="mood-label">The sound, by the numbers</p>
      <svg class="mood-chart" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Mood profile: dominated by calm, relaxed, and peaceful">
        <g class="mood-rings" fill="none" stroke="var(--line)" stroke-width="1">
          <circle cx="100" cy="100" r="28" />
          <circle cx="100" cy="100" r="56" />
          <circle cx="100" cy="100" r="84" />
        </g>
        <g class="mood-spokes" stroke="var(--line)" stroke-width="1">
          <line x1="100" y1="100" x2="100" y2="16" />
          <line x1="100" y1="100" x2="171.6" y2="53.4" />
          <line x1="100" y1="100" x2="180.6" y2="125.8" />
          <line x1="100" y1="100" x2="126.5" y2="182.1" />
          <line x1="100" y1="100" x2="61.1" y2="182.1" />
          <line x1="100" y1="100" x2="20" y2="140" />
          <line x1="100" y1="100" x2="20" y2="60" />
          <line x1="100" y1="100" x2="61.1" y2="17.9" />
          <line x1="100" y1="100" x2="18" y2="27.5" />
          <line x1="100" y1="100" x2="34.7" y2="86.5" />
        </g>
        <polygon points={radarPoints} class="mood-shape" />
        <text x="172" y="119" text-anchor="start" class="mood-tag">CALM 80</text>
        <text x="100" y="180" text-anchor="middle" class="mood-tag">RELAXED 70</text>
        <text x="141" y="160" text-anchor="start" class="mood-tag">PEACEFUL 70</text>
      </svg>
      <dl class="mood-stats">
        <div><dt>Genre</dt><dd>{song.genre}</dd></div>
        <div><dt>BPM</dt><dd>{song.bpm}</dd></div>
        <div><dt>Key</dt><dd>{song.key}</dd></div>
      </dl>
    </div>
  </section>

  <!-- LYRICS -->
  <section class="lyrics-section" aria-labelledby="lyrics-h">
    <h2 id="lyrics-h" class="section-h">Lyrics</h2>
    <p class="lyrics-credit">Words: Jason Nelson</p>
    <div class="lyrics">
      {LYRICS.map((block) => (
        <div class="lyrics-block">
          <p class="lyrics-label">{block.section}</p>
          {block.lines.map((line) => <p class="lyrics-line">{line}</p>)}
        </div>
      ))}
    </div>
  </section>

  <!-- BOTTOM CTA -->
  <section class="bottom-cta">
    <h2>Out {song.releaseDate}.</h2>
    <a class="cta" href={song.hyperfollow} target="_blank" rel="noopener">{song.ctaLabel} &mdash; Common Ground</a>
    <a class="secondary-link" href="/">Back to Jayesyn</a>
  </section>
</main>

<footer class="foot">
  <p class="foot-name">Jayesyn</p>
  <p class="foot-meta">
    Los Angeles, CA &middot; Booking &amp; press:
    <a href="mailto:garycrossey@irishguy.us">garycrossey@irishguy.us</a>
  </p>
  <p class="foot-credit">
    Released via <a href="https://irishguydesign.studio" rel="noopener">Irishguy Design Studio</a>
    &middot; &copy; {new Date().getFullYear()} Jayesyn. All rights reserved.
  </p>
</footer>

<style is:global>
:root {
  --carbon: #121014;
  --carbon-deep: #0d0b10;
  --cream: #efe6d8;
  --uv: #6399bb;
  --uv-soft: #82b0cb;
  --line: #2a2333;
  --dim: #9b93a8;
  --amber: #e8a15c;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  background: var(--carbon);
  color: var(--cream);
  font-family: 'Space Grotesk', system-ui, sans-serif;
  font-size: 17px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}
a { color: var(--uv-soft); }
a:focus-visible, button:focus-visible { outline: 2px solid var(--uv-soft); outline-offset: 3px; }

/* header */
.top {
  display: flex; align-items: center; gap: 1rem;
  padding: 1.1rem clamp(1.25rem, 4vw, 3rem);
  border-bottom: 1px solid var(--line);
}
.back {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.8rem; text-decoration: none; color: var(--dim);
}
.back:hover { color: var(--cream); }
.top-name {
  font-family: 'Unbounded', sans-serif;
  font-weight: 700; font-size: 0.85rem; letter-spacing: 0.1em;
}
.top-link {
  margin-left: auto;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.8rem; text-decoration: none;
  color: var(--cream); border-bottom: 1px solid var(--uv);
  padding-bottom: 2px;
}
.top-link:hover { color: var(--uv-soft); }

/* hero */
.hero {
  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
  align-items: center;
  gap: clamp(2rem, 5vw, 4rem);
  padding: clamp(3rem, 8vw, 6rem) clamp(1.25rem, 4vw, 3rem);
  max-width: 1200px; margin: 0 auto;
}
.eyebrow {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--uv-soft); margin-bottom: 1rem;
}
h1 {
  font-family: 'Unbounded', sans-serif;
  font-weight: 900;
  font-size: clamp(2.4rem, 7vw, 5rem);
  line-height: 0.98; letter-spacing: -0.01em;
}
.lede { margin-top: 1.5rem; max-width: 32rem; font-size: 1.1rem; }
.tag-row { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.5rem; }
.tag {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.72rem; letter-spacing: 0.06em;
  color: var(--dim);
  border: 1px solid var(--line);
  border-radius: 999px;
  padding: 0.3rem 0.75rem;
}
.cta {
  display: inline-block; margin-top: 2rem;
  font-family: 'Unbounded', sans-serif;
  font-weight: 700; font-size: 0.85rem;
  text-decoration: none;
  background: var(--uv); color: var(--cream);
  padding: 0.9rem 1.6rem; border-radius: 999px;
  transition: background 160ms ease;
}
.cta:hover { background: var(--uv-soft); }

.art-wrap {
  position: relative; aspect-ratio: 1;
  border-radius: 6px; overflow: hidden;
  box-shadow: 0 26px 64px -18px rgba(0, 0, 0, 0.9), 0 0 70px -20px rgba(99, 153, 187, 0.55);
}
.art-img { width: 100%; height: 100%; object-fit: cover; display: block; }

/* player */
.player-section {
  max-width: 1200px; margin: 0 auto;
  padding: clamp(2rem, 5vw, 3rem) clamp(1.25rem, 4vw, 3rem);
  border-top: 1px solid var(--line);
}
.section-h {
  font-family: 'Unbounded', sans-serif; font-weight: 700;
  font-size: clamp(1.3rem, 2.6vw, 1.8rem); margin-bottom: 1.25rem;
}
/* story + mood chart */
.story {
  max-width: 1200px; margin: 0 auto;
  padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.25rem, 4vw, 3rem);
  border-top: 1px solid var(--line);
  display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(280px, 0.9fr);
  gap: clamp(2rem, 5vw, 4rem);
  align-items: start;
}
.story-text p { max-width: 34rem; margin-bottom: 1.1rem; color: var(--cream); }
.story-text p:last-child { margin-bottom: 0; }

.mood-card {
  background: var(--carbon-deep);
  border: 1px solid var(--line);
  border-radius: 6px;
  padding: 1.5rem;
}
.mood-label {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--dim); margin-bottom: 0.75rem;
}
.mood-chart { width: 100%; height: auto; }
.mood-shape {
  fill: rgba(130, 176, 203, 0.28);
  stroke: var(--uv-soft);
  stroke-width: 1.5;
}
.mood-tag {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 6.5px; letter-spacing: 0.06em;
  fill: var(--dim);
}
.mood-stats {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 0.75rem; margin-top: 1.25rem;
  border-top: 1px solid var(--line); padding-top: 1.1rem;
}
.mood-stats dt {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--dim);
}
.mood-stats dd { font-weight: 500; margin-top: 0.2rem; font-size: 0.9rem; }

/* lyrics */
.lyrics-section {
  max-width: 1200px; margin: 0 auto;
  padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.25rem, 4vw, 3rem);
  border-top: 1px solid var(--line);
}
.lyrics-credit {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.78rem; color: var(--dim);
  margin-bottom: 1.75rem;
}
.lyrics {
  max-width: 34rem;
  display: flex; flex-direction: column; gap: 1.75rem;
}
.lyrics-label {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--uv-soft);
  margin-bottom: 0.6rem;
}
.lyrics-line {
  font-size: 1rem; color: var(--cream);
  line-height: 1.5;
}

/* bottom cta */
.bottom-cta {
  max-width: 1200px; margin: 0 auto;
  padding: clamp(3rem, 8vw, 5.5rem) clamp(1.25rem, 4vw, 3rem);
  border-top: 1px solid var(--line);
  text-align: center;
}
.bottom-cta h2 {
  font-family: 'Unbounded', sans-serif; font-weight: 900;
  font-size: clamp(1.8rem, 5vw, 3rem);
}
.bottom-cta .cta { display: block; width: fit-content; margin: 2rem auto 0; }
.secondary-link {
  display: block; margin-top: 1.25rem;
  font-family: 'IBM Plex Mono', monospace; font-size: 0.85rem;
  color: var(--dim); text-decoration: none;
}
.secondary-link:hover { color: var(--cream); }

/* footer */
.foot { border-top: 1px solid var(--line); padding: 2.5rem clamp(1.25rem, 4vw, 3rem) 3rem; text-align: center; }
.foot-name { font-family: 'Unbounded', sans-serif; font-weight: 700; font-size: 0.9rem; letter-spacing: 0.2em; }
.foot-meta { margin-top: 0.75rem; font-size: 0.9rem; color: var(--dim); }
.foot-credit { margin-top: 0.5rem; font-family: 'IBM Plex Mono', monospace; font-size: 0.75rem; color: var(--dim); }

/* responsive */
@media (max-width: 820px) {
  .hero { grid-template-columns: 1fr; }
  .art-wrap { order: -1; }
  .story { grid-template-columns: 1fr; }
}
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
}
</style>

</body>
</html>