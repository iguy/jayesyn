    lines: [
      'Turn off the poison feed',
      'Let the screen go cold tonight',
      'Look around your own street',
      'See the people holding life',
      'On the corner, by the courtyard',
      'At the market, in the park',
      "There's a thousand little kindnesses",
      'Lighting up the dark',
    ],
  },
  {
    section: 'Pre-Chorus',
    lines: [
      'So put the fear down',
      'Let the walls fall',
      'We were made for this',
      'We were made to call',
      'Across the water',
      'Across the line',
      'Our love can pull us',
