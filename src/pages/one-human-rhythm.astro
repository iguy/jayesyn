  { label: 'Angry', value: 0 },
];

// Precomputed 10-axis radar polygon (200x200 viewBox, center 100,100).
// r = 8 + (value/100)*80, angles at 36° steps starting from top, clockwise.
const radarPoints = '100,24 142.3,41.8 164.7,79 115.2,104.9 109.4,112.9 100,112 92.9,109.7 84.8,104.9 84.8,95.1 95.3,93.5';

const LYRICS = [
