    ],
  },
  {
    section: 'Chorus',
    lines: [
      'One human rhythm',
      'One human song',
      'We rise together',
      'When we move as one',
      'One human rhythm',
      'Love is enough',
      'Block out the fear',
      'And lift love up',
    ],
  },
  {
    section: 'Bridge',
    lines: [
      'If they feed you hate',
      "Don't eat that lie",
      'Look at the stranger',
      'Smiling by your side',
      'When they blast their static',
      'Let it fade away',
      'We got hands to hold',
      'And a world to save',
    ],
  },
  {
    section: 'Final Chorus',
    lines: [
      'One human rhythm',
      'One human song',
      'One human rhythm',
      'One human song',
      'We rise together',
      'When we move as one',
      'One human rhythm',
      'Love is enough',
