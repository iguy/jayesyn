  ctaLabel: 'Pre-save on all platforms',
  art: '/art/jayesyn-One_Human_rhythm.jpeg',
  genre: 'Dance-Pop / Electronic Pop',
  bpm: 118,
  key: 'C minor',
  tags: ['dance-pop', 'electronic', 'uplifting', 'anthemic', 'energetic', 'unity', 'male vocals', 'four-on-the-floor'],
};

// Straight from the track's own audio analysis — used below to draw the mood chart.
// (Order chosen for a clean shape, not the tool's default axis order.)
const moods = [
  { label: 'Energetic', value: 85 },
  { label: 'Excited', value: 80 },
  { label: 'Happy', value: 75 },
  { label: 'Calm', value: 10 },
